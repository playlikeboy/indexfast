{
	"name": "indexfast",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"test": "vitest run",
		"start": "next start",
		"lint": "eslint .",
		"db:migrate": "drizzle-kit migrate",
		"db:generate": "drizzle-kit generate",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cron:dev": "wrangler dev --test-scheduled",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
	},
	"dependencies": {
		"@dodopayments/nextjs": "^0.3.6",
		"@neondatabase/serverless": "^1.1.0",
		"@opennextjs/cloudflare": "^1.19.9",
		"@stackframe/stack": "^2.8.108",
		"drizzle-orm": "^0.45.2",
		"lucide-react": "^1.17.0",
		"next": "16.2.6",
		"react": "^19.1.7",
		"react-dom": "^19.1.7",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^25.9.1",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.1.7",
		"@types/react-dom": "^19.1.7",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9",
		"eslint-config-next": "16.2.6",
		"pg": "^8.21.0",
		"tailwindcss": "^4",
		"typescript": "^5.7.4",
		"vitest": "^4.1.8",
		"wrangler": "^4.96.0"
	}
}
