DATABASE_URL=
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=
# Optional dedicated key for encrypted third-party credentials. If blank, STACK_SECRET_SERVER_KEY is used.
CREDENTIAL_ENCRYPTION_KEY=
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_RETURN_URL=https://indexfast.co/dashboard
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_ID_INDIE=
DODO_PRODUCT_ID_GROWTH=
DODO_PRODUCT_ID_AGENCY=
DODO_PRODUCT_ID_SCALE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_CURRENCY=USD
ADMIN_EMAILS=
# Public base URL; used to build OAuth redirect URIs (defaults to the request origin).
NEXT_PUBLIC_SITE_URL=https://indexfast.co
# Google Search Console + Indexing API OAuth client (Google Cloud > APIs & Services > Credentials,
# type "Web application"). Enable the Search Console API and the Web Search Indexing API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to <NEXT_PUBLIC_SITE_URL>/api/integrations/google/callback. Must be listed
# as an authorized redirect URI on the OAuth client.
GOOGLE_REDIRECT_URI=
# Wrangler deploy credentials + R2 (S3-compatible)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
